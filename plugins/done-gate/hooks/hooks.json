{
  "description": "Done Gate: blocks 'done' until a passing test run after the last code edit",
  "hooks": {
    "PostToolUse": [{ "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash", "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/done_gate.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/done_gate.py\"", "timeout": 30 }] }],
    "PostToolUseFailure": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/done_gate.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/done_gate.py\"", "timeout": 30 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/done_gate.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/done_gate.py\"", "timeout": 60 }] }]
  }
}
